# 复制为 backend/.env（或项目根 .env 后按需调整）
# 未配置 LLM_API_KEY 时，系统自动使用“离线模板模式”：LangGraph 全图照常运行，数字仍由引擎计算。

# ---- Server ----
DEBUG=true
HOST=127.0.0.1
PORT=8000
CURRENT_TERM=2025-2026-2

# ---- Database ----
# 默认 SQLite：backend/data/app.db
# 生产示例：DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/academic
# DATABASE_URL=

# ---- Auth ----
JWT_SECRET=please-change-this-in-production
ACCESS_TOKEN_MINUTES=10080

# ---- LLM（OpenAI 兼容端点：DeepSeek / Qwen / 本地 vLLM）----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ---- LangGraph Checkpointer ----
# 默认 backend/data/checkpoints.sqlite（绝对路径由配置计算）
# CHECKPOINT_PATH=
